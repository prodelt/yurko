# Ukraine Laws MCP — Environment Variables
# Copy to .env for local HTTP mode testing

# Transport: stdio (local Claude Code) | http (remote server)
MCP_TRANSPORT=http

# API Key for authentication (leave empty = no auth)
# For production: use a strong random string
UKRAINE_LAWS_API_KEY=your-secret-key-here

# Server port (Render sets this automatically)
PORT=8000

# --- Postgres backend (optional, feature-flagged) -------------------------
# Enable the Supabase/Postgres + pgvector backend. Default off = file cache.
USE_PG_BACKEND=1
# Supabase connection string. Use the Transaction pooler (port 6543) in prod
# to stay within free-tier connection limits. URL-encode special chars in password.
#
# Supabase Transaction pooler (production): the "URI" connection string from
#   Supabase -> Project Settings -> Database, user postgres.<project-ref>,
#   host aws-0-eu-west-1.pooler.supabase.com, port 6543, database postgres.
#
# Direct connection (local dev / migrations): user postgres,
#   host db.<project-ref>.supabase.co, port 5432, database postgres.
#
# Local database from docker-compose.yml (throwaway password "pg"):
DATABASE_URL=postgresql://postgres:pg@localhost:5432/ukraine_laws

# --- Embeddings (used from MVP-1; free options only) ----------------------
# Auto: GeminiEmbedder if GOOGLE_API_KEY is set, else NullEmbedder (FTS-only).
# Override with EMBEDDING_PROVIDER=gemini|local|null.
GOOGLE_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
